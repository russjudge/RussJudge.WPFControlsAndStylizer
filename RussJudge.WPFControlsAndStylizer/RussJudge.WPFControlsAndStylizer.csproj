<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The list of supported frameworks lives in ..\Directory.Build.props -->
    <TargetFrameworks>$(StylizerTargetFrameworks)</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>rjicon.ico</ApplicationIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: not every public member has an XML comment yet. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>WPF Controls and Stylizer</Title>
    <Authors>Russ Judge</Authors>
    <Description>A collection of styles that I've thrown together and found useful.  Includes an ActivityIndicator and a "Placeholder" watermark for TextBox.</Description>
    <Copyright>Copyright (c) Russ Judge 2024-2026</Copyright>
    <PackageProjectUrl>https://russjudge.com</PackageProjectUrl>
    <PackageIcon>rjicon2.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/russjudge/RussJudge.WPFControlsAndStylizer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>WPF;Style;Button;Activity Indicator;Animated button;Placeholder</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <VersionPrefix>1.2.0</VersionPrefix>
    <AssemblyVersion>1.2.0</AssemblyVersion>
    <FileVersion>1.2.0</FileVersion>
    <PackageReleaseNotes>Run through Claude Code: Now targets .NET Framework 4.5 - 4.8.1 and .NET 5 - 11.  Bug fixes and performance improvements - see the README for details.</PackageReleaseNotes>
  </PropertyGroup>

  <!--
    Resources\*.png and rjicon.ico are left as ordinary (None) project items on purpose.  They are embedded through
    Properties\Resources.resx / ApplicationIcon.  Declaring them as Content would pack them as contentFiles, which
    copies them into every project that references the NuGet package.
  -->

  <ItemGroup>
    <None Include="..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\rjicon2.png" Pack="True" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
